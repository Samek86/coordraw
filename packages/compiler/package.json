    "@eraserlabs/diagrams": "^0.1.0",
    "@eraserlabs/diagrams-cli": "^0.1.0",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
