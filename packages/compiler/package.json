{
  "name": "@coordraw/compiler",
  "version": "0.1.0",
  "type": "module",
  "description": "Coordraw DSL to Eraser Diagrams compiler",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "coordraw": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
